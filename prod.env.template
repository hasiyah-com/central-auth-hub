# ============================================================================
# PRODUCTION env template — Hub stack (cah-hub)
# ----------------------------------------------------------------------------
# วิธีใช้:
#   cp prod.env.template .env.prod
#   แก้ค่า + ใส่ secret จริง (.env.prod ถูก gitignore — ห้าม commit)
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# generate secret:
#   SECRET_KEY:             openssl rand -hex 32
#   SECRET_ENCRYPTION_KEY:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
#   POSTGRES_PASSWORD:      openssl rand -hex 24
#   WEBHOOK_SHARED_KEY:     python -c "import secrets;print(secrets.token_urlsafe(32))"
# ============================================================================

# ---- โดเมนหลัก (apex) — ใช้โดย nginx + frontend build + compose interpolation ----
# subdomain: admin.<DOMAIN> / auth.<DOMAIN> / dorm.<DOMAIN> / library.<DOMAIN>
DOMAIN=example.com

# ---- Hub Database ----
POSTGRES_USER=hub_prod
POSTGRES_PASSWORD=CHANGE_ME_strong_random  # pragma: allowlist secret
POSTGRES_DB=hub_db

# ---- Hub Backend ----
APP_ENV=production
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32  # pragma: allowlist secret
SECRET_ENCRYPTION_KEY=CHANGE_ME_Fernet_generate_key  # pragma: allowlist secret
HUB_BASE_URL=https://auth.example.com
HUB_ISSUER=https://auth.example.com
ENABLE_DOCS=false
JWT_PRIVATE_KEY_PATH=/app/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/jwt_public.pem
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_HUB_AUDIENCE=hub.internal

# ---- Admin frontend (console) + CORS ----
# console อยู่ที่ admin.<DOMAIN> (แยกจาก auth. เพราะ route path ชนกัน)
ADMIN_FRONTEND_URL=https://admin.example.com
CORS_ALLOW_ORIGINS=https://admin.example.com,https://dorm.example.com,https://library.example.com,https://grade.example.com

# ---- Google OAuth (เพิ่ม redirect URI ใน Google Console + ย้าย app เป็น Production) ----
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret  # pragma: allowlist secret
GOOGLE_REDIRECT_URI=https://auth.example.com/auth/google/callback
OAUTH_CALLBACK_URI=https://auth.example.com/oauth/callback

# ---- ML Service ----
ML_SERVICE_URL=http://ml-service:9000
ML_TIMEOUT_SECONDS=2.0
# เริ่มที่ true (Shadow Mode — log อย่างเดียว) → flip เป็น false หลัง calibrate
ML_SHADOW_MODE=true

# ---- GeoIP (วางไฟล์จริงที่ host ./hub/backend/data/GeoLite2-Country.mmdb) ----
GEOIP_DB_PATH=/app/data/GeoLite2-Country.mmdb

# ---- Email (OTP / recovery / alert) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email
SMTP_PASSWORD=your-app-password  # pragma: allowlist secret
EMAIL_FROM=noreply@example.com

# ---- Webhook back-channel (ต้องตรงกับทุก subsystem) ----
WEBHOOK_SHARED_KEY=CHANGE_ME_token_urlsafe_32

# ---- Structured Logging ----
LOG_FORMAT=json
LOG_LEVEL=INFO

# ---- Alerting (เลือกช่องทางที่ใช้ ปล่อยว่าง = ปิด) ----
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=
ALERT_MIN_SEVERITY=warning

# ---- WebAuthn / Passkey (สำคัญ — ผูกกับ domain แบบ cryptographic) ----
# RP ID = apex domain → passkey ใช้ได้ทั้ง admin. (register) และ auth. (ceremony)
WEBAUTHN_RP_ID=example.com
WEBAUTHN_RP_NAME=Central Auth Hub
WEBAUTHN_ORIGINS=https://admin.example.com,https://auth.example.com
