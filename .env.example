# ============ Hub Database (set ค่าจริงใน .env เท่านั้น) ============
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=your-db-name

# ============ Subsystem A — Postgres แยก (Week 6) ============
DORM_POSTGRES_USER=dorm
DORM_POSTGRES_PASSWORD=replace-with-strong-password
DORM_POSTGRES_DB=dorm_db

# ============ Subsystem B — Postgres แยก (Week 7) ============
LIBRARY_POSTGRES_USER=library
LIBRARY_POSTGRES_PASSWORD=replace-with-strong-password
LIBRARY_POSTGRES_DB=library_db

# ============ Hub Backend ============
APP_ENV=development
SECRET_KEY=change-this-to-random-64-chars-in-production
# คีย์แยกสำหรับ encrypt client_secret ใน DB (ใช้ Fernet) — production ต้องตั้ง
# Dev: ปล่อยว่างได้ จะ fallback ไป SECRET_KEY พร้อม warning
SECRET_ENCRYPTION_KEY=
# Base URL ของ Hub — ใช้สร้าง one-time secret retrieval link
HUB_BASE_URL=http://localhost:8000
# true ใน dev / false ใน production (ปิด Swagger /docs)
ENABLE_DOCS=true
JWT_PRIVATE_KEY_PATH=/app/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/jwt_public.pem
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# audience ของ JWT ที่ Hub ออกใช้กับ Hub เอง (กัน subsystem token ใช้ที่ Hub)
JWT_HUB_AUDIENCE=hub.internal

# ============ Google OAuth (สมัครที่ https://console.cloud.google.com) ============
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# callback สำหรับ subsystem OAuth flow (ต้องเพิ่มใน Google Console ด้วย)
OAUTH_CALLBACK_URI=http://localhost:8000/oauth/callback

# ============ ML Service ============
ML_SERVICE_URL=http://ml-service:9000
ML_TIMEOUT_SECONDS=2.0
# true = log score เท่านั้น (Shadow Mode) / false = บล็อกตาม ML จริง
ML_SHADOW_MODE=true

# ============ GeoIP (MaxMind GeoLite2 — offline lookup) ============
# ดาวน์โหลดฟรีที่ https://www.maxmind.com/en/geolite2/signup
# วางไฟล์ที่ hub/backend/data/GeoLite2-Country.mmdb (gitignored)
# ถ้าไฟล์ไม่มี → geo features ใช้ neutral defaults (login flow ยังทำงานปกติ)
GEOIP_DB_PATH=/app/data/GeoLite2-Country.mmdb

# ============ Email (สำหรับส่ง one-time link + alerts) ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@hub.local

# ============ Webhook Back-channel (Hub → Subsystem) ============
# shared HMAC key ใช้ sign payload ที่ Hub ส่งหา subsystem
# ทั้ง Hub และ subsystem ทุกตัวต้องตั้งค่าเดียวกัน
# generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
WEBHOOK_SHARED_KEY=

# ============ Structured Logging ============
# text = dev อ่านง่าย / json = production (ส่งเข้า ELK/Loki/Datadog)
LOG_FORMAT=text
LOG_LEVEL=INFO

# ============ Alerting (webhook + email) ============
# Slack incoming-webhook URL หรือ Discord webhook (รูปแบบ JSON เหมือนกัน)
# ปล่อยว่าง = ปิด webhook channel
ALERT_WEBHOOK_URL=
# Telegram Bot API (ตั้งทั้ง 2 ตัวถึงจะส่ง)
# token จาก @BotFather, chat_id จาก @userinfobot หรือ getUpdates
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# email admin / oncall — ปล่อยว่าง = ปิด email channel
ALERT_EMAIL_TO=
# ระดับขั้นต่ำที่จะส่งจริง: info | warning | critical
ALERT_MIN_SEVERITY=warning
# cooldown ต่อ (kind, key) นาที — กัน flood ซ้ำๆ
ALERT_COOLDOWN_MINUTES=60
# ML score thresholds สำหรับ fire alert (0.0–1.0)
ALERT_ML_CRITICAL_THRESHOLD=0.70
ALERT_ML_WARNING_THRESHOLD=0.50
