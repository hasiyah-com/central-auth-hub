# Isolated Docker test environment
# Copy to .env.test. This file contains test-only values and must never be used in production.

COMPOSE_PROJECT_NAME=cah-isolated-test

# Host ports (bound to 127.0.0.1 only)
TEST_FRONTEND_PORT=13000
TEST_HUB_PORT=18000
TEST_DORM_PORT=18001
TEST_LIBRARY_PORT=18002
TEST_ML_PORT=19000
TEST_POSTGRES_PORT=15432
TEST_DORM_POSTGRES_PORT=15433
TEST_LIBRARY_POSTGRES_PORT=15434
TEST_REDIS_PORT=16379

# Hub database
POSTGRES_USER=hub_test
POSTGRES_PASSWORD=hub_test_password
POSTGRES_DB=hub_test_db

# Subsystem databases
DORM_POSTGRES_USER=dorm_test
DORM_POSTGRES_PASSWORD=dorm_test_password
DORM_POSTGRES_DB=dorm_test_db
LIBRARY_POSTGRES_USER=library_test
LIBRARY_POSTGRES_PASSWORD=library_test_password
LIBRARY_POSTGRES_DB=library_test_db

# Hub backend — test only
APP_ENV=development
SECRET_KEY=test-only-secret-key-change-before-shared-staging-0123456789abcdef
SECRET_ENCRYPTION_KEY=
HUB_BASE_URL=http://localhost:18000
HUB_ISSUER=http://localhost:18000
ADMIN_FRONTEND_URL=http://localhost:13000
NEXT_PUBLIC_HUB_URL=http://localhost:18000
CORS_ALLOW_ORIGINS=http://localhost:13000,http://localhost:18001,http://localhost:18002
ENABLE_DOCS=true
JWT_PRIVATE_KEY_PATH=/app/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/jwt_public.pem
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_HUB_AUDIENCE=hub.internal

# OAuth — create a separate test client before exercising browser login
GOOGLE_CLIENT_ID=replace-with-test-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-test-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:18000/auth/google/callback
OAUTH_CALLBACK_URI=http://localhost:18000/oauth/callback
GOOGLE_CHANGE_REDIRECT_URI=http://localhost:18000/auth/account/change-google/callback
LINE_CLIENT_ID=replace-with-test-line-channel-id
LINE_CLIENT_SECRET=replace-with-test-line-channel-secret
LINE_REDIRECT_URI=http://localhost:18000/auth/line/callback

# ML / risk — shadow mode prevents test traffic from enforcing blocks
ML_SERVICE_URL=http://ml-service-test:9000
ML_TIMEOUT_SECONDS=2.0
ML_SHADOW_MODE=true
L3_SEQUENCE_ENABLED=false
L3_TIMEOUT_SECONDS=0.5

# Passkey — localhost is accepted without HTTPS
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Central Auth Hub Test
WEBAUTHN_ORIGINS=http://localhost:13000,http://localhost:18000
WEBAUTHN_CHALLENGE_TTL_SEC=300
WEBAUTHN_BACKUP_CODES_COUNT=10
WEBAUTHN_MAX_PASSKEYS_PER_USER=10
STEPUP_CACHE_TTL_SEC=900
STEPUP_COUNTER_REGRESSION_RISK_BOOST=0.2

# Optional integrations — intentionally disabled in the isolated stack
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@test.local
WEBHOOK_SHARED_KEY=test-only-webhook-key
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=
ALERT_MIN_SEVERITY=critical
ALERT_COOLDOWN_MINUTES=60
ALERT_ML_CRITICAL_THRESHOLD=0.70
ALERT_ML_WARNING_THRESHOLD=0.50
LOG_FORMAT=text
LOG_LEVEL=INFO
GEOIP_DB_PATH=/app/data/GeoLite2-Country.mmdb

# Optional subsystem profile.
# Register both test subsystems in the test Hub, then put their test credentials here.
DORM_CLIENT_ID=
DORM_CLIENT_SECRET=
DORM_SESSION_SECRET_KEY=test-only-dorm-session-secret-change-me
LIBRARY_CLIENT_ID=
LIBRARY_CLIENT_SECRET=
LIBRARY_SESSION_SECRET_KEY=test-only-library-session-secret-change-me
