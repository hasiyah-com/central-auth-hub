# auth.${DOMAIN}  →  hub-backend:8000 (OAuth, passkey API, JWKS, OIDC, Hub-served HTML)

server {
    listen 80;
    server_name auth.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name auth.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/auth.${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/auth.${DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/ssl-params.conf;

    location / {
        include /etc/nginx/snippets/proxy-params.conf;
        proxy_pass http://hub-backend:8000;
    }
}
