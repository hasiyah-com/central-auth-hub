{
  "name": "central-auth-hub/php-client",
  "description": "Official PHP SDK for Central Auth Hub — handle OAuth 2.0 + PKCE + JWT verification with ~10 lines of code.",
  "type": "library",
  "license": "MIT",
  "keywords": ["oauth2", "oidc", "jwt", "pkce", "authentication", "central-auth-hub"],
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "firebase/php-jwt": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "CentralAuthHub\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CentralAuthHub\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit tests"
  },
  "config": {
    "policy": {
      "audit": {
        "block": false
      }
    }
  }
}
