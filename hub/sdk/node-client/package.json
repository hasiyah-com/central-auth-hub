{
  "name": "@central-auth-hub/node-client",
  "version": "0.1.0",
  "description": "Official Node.js SDK for Central Auth Hub — OAuth 2.0 + PKCE + JWT verification with ~10 lines of code.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts"
  },
  "dependencies": {
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "keywords": ["oauth2", "oidc", "jwt", "pkce", "authentication", "central-auth-hub"],
  "license": "MIT"
}
