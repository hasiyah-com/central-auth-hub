# ============================================================================
# PRODUCTION env template — Subsystem B (Library, cah-library)
# ----------------------------------------------------------------------------
#   cp prod.env.template .env.prod   (ในโฟลเดอร์ hub/subsystem-library/)
#   docker compose --env-file hub/subsystem-library/.env.prod -f docker-compose.library.prod.yml up -d --build
#
# generate: SESSION_SECRET_KEY/POSTGRES_PASSWORD → openssl rand -hex 32
# ============================================================================

# ---- App ----
APP_ENV=production
SESSION_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32  # pragma: allowlist secret

# ---- Database (postgres-library) ----
LIBRARY_POSTGRES_USER=library_prod
LIBRARY_POSTGRES_PASSWORD=CHANGE_ME_strong_random  # pragma: allowlist secret
LIBRARY_POSTGRES_DB=library_db

# ---- OAuth client (จากการลงทะเบียน subsystem กับ Hub) ----
LIBRARY_CLIENT_ID=
LIBRARY_CLIENT_SECRET=

# ---- Hub URLs ----
HUB_INTERNAL_URL=http://hub-backend:8000
HUB_PUBLIC_URL=https://auth.example.com
HUB_FRONTEND_URL=https://admin.example.com

# subsystem ตัวเอง
LIBRARY_PUBLIC_URL=https://library.example.com
LIBRARY_CALLBACK_URL=https://library.example.com/oauth/callback

# ---- Session (prod ต้อง Secure=true) ----
SESSION_COOKIE_NAME=library_session
SESSION_MAX_AGE_SECONDS=3600
SESSION_COOKIE_SECURE=true

# ---- OIDC issuer (ต้องตรงกับ Hub HUB_ISSUER) ----
HUB_ISSUER=https://auth.example.com

# ---- Webhook (ต้องตรงกับ Hub WEBHOOK_SHARED_KEY) ----
HUB_WEBHOOK_SHARED_KEY=CHANGE_ME_match_hub

# ---- Business Rules ----
DEFAULT_BORROW_DAYS=14
MAX_BORROWS_PER_MEMBER=3
