# ============ App ============
APP_ENV=development
SESSION_SECRET_KEY=change-this-to-random-64-chars-in-production

# ============ Database (postgres-library — แยกจาก Hub และจาก dorm) ============
LIBRARY_POSTGRES_USER=library
LIBRARY_POSTGRES_PASSWORD=librarypass
LIBRARY_POSTGRES_DB=library_db

# ============ OAuth Client credentials กับ Hub ============
# กรอกหลังลงทะเบียนกับ Hub ผ่าน /developer/subsystems
LIBRARY_CLIENT_ID=
LIBRARY_CLIENT_SECRET=

# ============ Hub URLs ============
HUB_INTERNAL_URL=http://hub-backend:8000
HUB_PUBLIC_URL=http://localhost:8000

# Callback URL (ต้อง register ตอนลงทะเบียน subsystem)
LIBRARY_CALLBACK_URL=http://localhost:8002/oauth/callback

# ============ Session ============
SESSION_COOKIE_NAME=library_session
SESSION_MAX_AGE_SECONDS=3600
SESSION_COOKIE_SECURE=false

# ============ Business Rules ============
# จำนวนวันที่ยืมได้ต่อครั้ง
DEFAULT_BORROW_DAYS=14
# จำนวนเล่มสูงสุดที่ยืมพร้อมกันได้
MAX_BORROWS_PER_MEMBER=3
