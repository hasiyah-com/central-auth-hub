# ระบบเกรด (Grade System) — subsystem C
# คัดลอกเป็น .env แล้วเติมค่าจาก register_grade_subsystem.py

APP_ENV=development
SESSION_SECRET_KEY=change-me-in-prod

# SQLite path (self-contained)
DB_PATH=/app/data/grade.db

# จาก: docker compose exec hub-backend python -m scripts.register_grade_subsystem
GRADE_CLIENT_ID=cli_grade
GRADE_CLIENT_SECRET=
GRADE_ROSTER_API_KEY=

# Hub URLs (internal = docker service name / public = browser localhost)
HUB_INTERNAL_URL=http://hub-backend:8000
HUB_PUBLIC_URL=http://localhost:8000

GRADE_PUBLIC_URL=http://localhost:8003
GRADE_CALLBACK_URL=http://localhost:8003/oauth/callback

# ต้องตรงกับ Hub settings.hub_issuer
HUB_ISSUER=https://hub.local

# ต้องเป็นค่าเดียวกับ Hub WEBHOOK_SHARED_KEY (ใน .env ของ Hub) — ใช้ verify
# webhook ที่ Hub push มาตอน revoke/เปลี่ยน scope-role → บังคับ re-auth
HUB_WEBHOOK_SHARED_KEY=
