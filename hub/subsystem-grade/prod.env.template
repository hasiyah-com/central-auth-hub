# ============================================================================
# PRODUCTION env template — Subsystem C (Grade, cah-grade)
# ----------------------------------------------------------------------------
#   cp prod.env.template .env.prod   (ในโฟลเดอร์ hub/subsystem-grade/)
#   docker compose --env-file hub/subsystem-grade/.env.prod -f docker-compose.grade.prod.yml up -d --build
#
# GRADE_CLIENT_ID / GRADE_CLIENT_SECRET / GRADE_ROSTER_API_KEY มาจาก:
#   GRADE_REDIRECT_URI=https://grade.example.com/oauth/callback \
#     docker compose --env-file .env.prod -f docker-compose.prod.yml \
#     exec hub-backend python -m scripts.register_grade_subsystem
#
# generate: SESSION_SECRET_KEY → openssl rand -hex 32
# ============================================================================

# ---- App ----
APP_ENV=production
SESSION_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32  # pragma: allowlist secret

# ---- OAuth client (จาก register_grade_subsystem.py) ----
GRADE_CLIENT_ID=
GRADE_CLIENT_SECRET=

# ---- Roster Sync API key (rsk_..., จาก register_grade_subsystem.py) ----
GRADE_ROSTER_API_KEY=

# ---- Hub URLs ----
HUB_INTERNAL_URL=http://hub-backend:8000
HUB_PUBLIC_URL=https://auth.example.com

# subsystem ตัวเอง
GRADE_PUBLIC_URL=https://grade.example.com
GRADE_CALLBACK_URL=https://grade.example.com/oauth/callback

# ---- Session (prod ต้อง Secure=true) ----
SESSION_COOKIE_NAME=grade_session
SESSION_MAX_AGE_SECONDS=3600
SESSION_COOKIE_SECURE=true

# ---- OIDC issuer (ต้องตรงกับ Hub HUB_ISSUER) ----
HUB_ISSUER=https://auth.example.com

# ---- Webhook (ต้องตรงกับ Hub WEBHOOK_SHARED_KEY) ----
HUB_WEBHOOK_SHARED_KEY=CHANGE_ME_match_hub
