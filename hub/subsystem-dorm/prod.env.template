# ============================================================================
# PRODUCTION env template — Subsystem A (Dorm, cah-dorm)
# ----------------------------------------------------------------------------
#   cp prod.env.template .env.prod   (ในโฟลเดอร์ hub/subsystem-dorm/)
#   docker compose --env-file hub/subsystem-dorm/.env.prod -f docker-compose.dorm.prod.yml up -d --build
#
# generate: SESSION_SECRET_KEY/POSTGRES_PASSWORD → openssl rand -hex 32
# ============================================================================

# ---- App ----
APP_ENV=production
SESSION_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32  # pragma: allowlist secret

# ---- Database (postgres-dorm) ----
DORM_POSTGRES_USER=dorm_prod
DORM_POSTGRES_PASSWORD=CHANGE_ME_strong_random  # pragma: allowlist secret
DORM_POSTGRES_DB=dorm_db

# ---- OAuth client (จากการลงทะเบียน subsystem กับ Hub ผ่าน /developer/subsystems) ----
DORM_CLIENT_ID=
DORM_CLIENT_SECRET=

# ---- Hub URLs ----
# internal = server-to-server (token exchange, JWKS) บน cah-net
HUB_INTERNAL_URL=http://hub-backend:8000
# public = ที่ browser เห็น (redirect)
HUB_PUBLIC_URL=https://auth.example.com
# console ของ Hub (ลิงก์ไปหน้า passkey recover)
HUB_FRONTEND_URL=https://admin.example.com

# subsystem ตัวเอง
DORM_PUBLIC_URL=https://dorm.example.com
DORM_CALLBACK_URL=https://dorm.example.com/oauth/callback

# ---- Session (prod ต้อง Secure=true เพราะ HTTPS) ----
SESSION_COOKIE_NAME=dorm_session
SESSION_MAX_AGE_SECONDS=3600
SESSION_COOKIE_SECURE=true

# ---- OIDC issuer (ต้องตรงกับ Hub HUB_ISSUER) ----
HUB_ISSUER=https://auth.example.com

# ---- Webhook (ต้องตรงกับ Hub WEBHOOK_SHARED_KEY) ----
HUB_WEBHOOK_SHARED_KEY=CHANGE_ME_match_hub
