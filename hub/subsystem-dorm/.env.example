# ============ App ============
APP_ENV=development
# คีย์สำหรับ sign session cookie ของ subsystem นี้ (แยกจาก Hub)
SESSION_SECRET_KEY=change-this-to-random-64-chars-in-production

# ============ Database (postgres-dorm — แยกจาก Hub) ============
DORM_POSTGRES_USER=dorm
DORM_POSTGRES_PASSWORD=dormpass
DORM_POSTGRES_DB=dorm_db

# ============ OAuth Client credentials กับ Hub ============
# กรอกหลังลงทะเบียนกับ Hub ผ่าน /developer/subsystems และ retrieve secret
DORM_CLIENT_ID=
DORM_CLIENT_SECRET=

# ============ Hub URLs ============
# internal — ใช้ตอน server-to-server (token exchange, JWKS fetch)
HUB_INTERNAL_URL=http://hub-backend:8000
# public — ใช้ตอน browser redirect (URL ที่ผู้ใช้เห็นใน address bar)
HUB_PUBLIC_URL=http://localhost:8000

# Callback URL ของ subsystem (ต้อง register กับ Hub ตรงนี้)
DORM_CALLBACK_URL=http://localhost:8001/oauth/callback

# ============ Session ============
SESSION_COOKIE_NAME=dorm_session
SESSION_MAX_AGE_SECONDS=3600
# false ใน dev (localhost ไม่มี HTTPS) / true ใน production
SESSION_COOKIE_SECURE=false
