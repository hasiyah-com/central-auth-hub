{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://central-auth-hub.local/schemas/rba-metrics-v1.json",
  "title": "RBA Experiment Metric Row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id", "scope", "scope_value", "dataset_size", "seed",
    "normal_count", "attack_count", "tp", "fp", "tn", "fn",
    "precision", "recall", "f1", "roc_auc", "pr_auc", "fpr",
    "allow_rate", "warn_plus_fpr", "warn_plus_recall",
    "challenge_plus_fpr", "challenge_plus_recall", "block_fpr",
    "block_recall", "allow_count", "warn_count", "challenge_count",
    "block_count", "mean_risk", "median_risk", "p90_risk", "p95_risk"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "scope": {"type": "string", "enum": ["overall", "profile", "role", "scenario", "dataset_size", "seed"]},
    "scope_value": {"type": "string"},
    "dataset_size": {"type": "integer"},
    "seed": {"type": "integer"},
    "normal_count": {"type": "integer", "minimum": 0},
    "attack_count": {"type": "integer", "minimum": 0},
    "tp": {"type": "integer", "minimum": 0},
    "fp": {"type": "integer", "minimum": 0},
    "tn": {"type": "integer", "minimum": 0},
    "fn": {"type": "integer", "minimum": 0},
    "precision": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "f1": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "roc_auc": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "pr_auc": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "fpr": {"type": "number", "minimum": 0, "maximum": 1},
    "allow_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "warn_plus_fpr": {"type": "number", "minimum": 0, "maximum": 1},
    "warn_plus_recall": {"type": "number", "minimum": 0, "maximum": 1},
    "challenge_plus_fpr": {"type": "number", "minimum": 0, "maximum": 1},
    "challenge_plus_recall": {"type": "number", "minimum": 0, "maximum": 1},
    "block_fpr": {"type": "number", "minimum": 0, "maximum": 1},
    "block_recall": {"type": "number", "minimum": 0, "maximum": 1},
    "allow_count": {"type": "integer", "minimum": 0},
    "warn_count": {"type": "integer", "minimum": 0},
    "challenge_count": {"type": "integer", "minimum": 0},
    "block_count": {"type": "integer", "minimum": 0},
    "mean_risk": {"type": "number", "minimum": 0, "maximum": 1},
    "median_risk": {"type": "number", "minimum": 0, "maximum": 1},
    "p90_risk": {"type": "number", "minimum": 0, "maximum": 1},
    "p95_risk": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
