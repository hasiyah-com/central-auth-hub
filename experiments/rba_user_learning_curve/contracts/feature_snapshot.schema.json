{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://central-auth-hub.local/schemas/rba-feature-snapshot-v1.json",
  "title": "RBA Experiment 23-Feature Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id", "event_id", "profile_id", "created_at", "split", "scenario",
    "ground_truth", "label", "hour_of_day", "day_of_week",
    "hours_from_typical_login_time", "is_thailand", "is_new_country",
    "country_change_count_30d", "is_new_device", "is_new_user_agent_family",
    "log_minutes_since_last_login", "login_count_24h", "failed_logins_24h",
    "passkey_count", "passkey_age_days", "new_passkey_recently_added",
    "passkey_last_used_days", "concurrent_session_count",
    "active_subsystem_count", "weekday_usage_score",
    "scope_sensitivity_score", "ever_changed_permission",
    "permission_change_age", "confirmed_incident_count",
    "impossible_travel_score"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "event_id": {"type": "string", "format": "uuid"},
    "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "split": {"type": "string", "enum": ["train", "normal_test", "attack_test"]},
    "scenario": {"type": "string"},
    "ground_truth": {"type": "string", "enum": ["normal", "attack"]},
    "label": {"type": "integer", "enum": [0, 1]},
    "hour_of_day": {"type": "number", "minimum": 0, "maximum": 23},
    "day_of_week": {"type": "number", "minimum": 0, "maximum": 6},
    "hours_from_typical_login_time": {"type": "number", "minimum": 0, "maximum": 12},
    "is_thailand": {"const": 1.0},
    "is_new_country": {"const": 0.0},
    "country_change_count_30d": {"const": 0.0},
    "is_new_device": {"type": "number", "minimum": 0, "maximum": 1},
    "is_new_user_agent_family": {"type": "number", "minimum": 0, "maximum": 1},
    "log_minutes_since_last_login": {"type": "number", "minimum": -5, "maximum": 15},
    "login_count_24h": {"type": "number", "minimum": 0, "maximum": 1000},
    "failed_logins_24h": {"type": "number", "minimum": 0, "maximum": 1000},
    "passkey_count": {"type": "number", "minimum": 0, "maximum": 20},
    "passkey_age_days": {"type": "number", "minimum": 0, "maximum": 3650},
    "new_passkey_recently_added": {"type": "number", "minimum": 0, "maximum": 1},
    "passkey_last_used_days": {"type": "number", "minimum": 0, "maximum": 3650},
    "concurrent_session_count": {"type": "number", "minimum": 0, "maximum": 50},
    "active_subsystem_count": {"type": "number", "minimum": 0, "maximum": 20},
    "weekday_usage_score": {"type": "number", "minimum": 0, "maximum": 1},
    "scope_sensitivity_score": {"type": "number", "minimum": 0, "maximum": 1},
    "ever_changed_permission": {"type": "number", "minimum": 0, "maximum": 1},
    "permission_change_age": {"type": "number", "minimum": 0, "maximum": 365},
    "confirmed_incident_count": {"type": "number", "minimum": 0, "maximum": 1000},
    "impossible_travel_score": {"const": 0.0}
  }
}
