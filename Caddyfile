# Caddy 2 — Mode C production reverse proxy
#
# วิธี deploy:
#   1. แก้ <DOMAIN> ด้านล่างให้ตรงกับ domain ของคุณ
#   2. ชี้ DNS A record ของทุก subdomain → server public IP
#   3. docker compose -f docker-compose.yml -f docker-compose.caddy.yml up -d
#
# Caddy จะขอ Let's Encrypt cert อัตโนมัติตอนเริ่มต้น (~30 วินาที)
# Renew อัตโนมัติทุก 60 วัน

# ─── Hub API ────────────────────────────────────────────────
hub.<DOMAIN> {
    encode zstd gzip
    reverse_proxy hub-backend:8000 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-For {remote_host}
    }

    log {
        output stdout
        format console
    }
}

# ─── Admin / Developer Frontend (Next.js) ───────────────────
admin.<DOMAIN> {
    encode zstd gzip
    reverse_proxy hub-frontend:3000 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-For {remote_host}
    }
}

# ─── Subsystem A: ระบบหอพัก ─────────────────────────────────
dorm.<DOMAIN> {
    encode zstd gzip
    reverse_proxy subsystem-dorm:8000 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-For {remote_host}
    }
}

# ─── Subsystem B: ระบบห้องสมุด ──────────────────────────────
library.<DOMAIN> {
    encode zstd gzip
    reverse_proxy subsystem-library:8000 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-For {remote_host}
    }
}

# ─── ML Service (optional — เปิดถ้า admin ต้องการ debug ตรง) ─
# ml.<DOMAIN> {
#     reverse_proxy ml-service:9000
# }
